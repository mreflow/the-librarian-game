{
  "name": "the-librarian",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A stylized 3D library chaos-control action roguelite.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src/v2 tests scripts --deny-warnings",
    "typecheck": "tsc --noEmit",
    "balance:simulate": "tsx scripts/simulate-balance.ts",
    "validate:assets": "node scripts/validate-v2-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run validate:assets && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "oxlint": "^1.74.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babylonjs/core": "^9.17.0"
  }
}
